# Copy to .env.local for local builds, or set in Vercel → Project → Settings → Environment Variables.

# Public origin of the site (no trailing slash). Used for canonical URLs, the sitemap,
# Open Graph images and JSON-LD. On Vercel it falls back to the project's production URL
# until this is set, so it can wait until the custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin (/keystatic) in GitHub mode. Keystatic writes these to .env when you create its GitHub App
# (see README → ตั้งค่า GitHub mode ครั้งแรก); copy them to Vercel. Without them the site still
# builds, only signing in to /keystatic on the deployed site fails.
# Left commented out: empty values in .env.local would override the real ones in .env.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Local development only: set to "github" to test the GitHub sign-in locally instead of editing files directly.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
